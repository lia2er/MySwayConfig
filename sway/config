# Mod key
set $mod Mod4

# Programs shortcuts
set $term foot
set $menu wofi -i --show drun
set $dmenu dmenu
set $mlog wlogout
set $swaync swaync-client -t -sw

# Screen outputs
output Virtual-1 {
    resolution 1920x1080
    position 1920,0
    background ~/Pictures/Wallpapers/tux.png fill
}

# Autoruns while startup
exec swayidle -w \
         timeout 300 'swaylock -u -f -c 000000' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -u -f -c 000000'
exec swaync
exec /usr/lib/xfce-polkit/xfce-polkit
exec gsettings set org.gnome.desktop.interface gtk-theme "adw-gtk3"

# Input devices
input "type:keyboard" {
     xkb_layout us,ua(homophonic)
     xkb_options grp:win_space_toggle
     repeat_delay 300
     repeat_rate 30
}
input "type:touchpad" {
    dwt disabled
    tap enabled
    middle_emulation enabled
}
input "type:pointer" {
    accel_profile flat
}

# Some Sway configs
default_border pixel 1
client.focused #424040 #504F4F #FFFFFF
gaps inner 0
gaps outer 0
focus_follows_mouse no
floating_modifier $mod normal
focus_on_window_activation focus

# Gesture bindings
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next

# Key bindings
bindsym --to-code {
    # Apps shortcuts
    $mod+t exec $term
    $mod+Shift+q kill
    $mod+Shift+r exec $menu
    $mod+Shift+Escape exec $mlog
    $mod+Shift+n exec $swaync

    # Screenshot tool
    Print exec grim

    # Reload sway
    $mod+Shift+c reload

    # Windows navigation
    $mod+Left focus left
    $mod+Down focus down
    $mod+Up focus up
    $mod+Right focus right

    $mod+Shift+Left move left
    $mod+Shift+Down move down
    $mod+Shift+Up move up
    $mod+Shift+Right move right

    # Workspace switching
    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9

    $mod+Shift+1 move container to workspace number 1
    $mod+Shift+2 move container to workspace number 2
    $mod+Shift+3 move container to workspace number 3
    $mod+Shift+4 move container to workspace number 4
    $mod+Shift+5 move container to workspace number 5
    $mod+Shift+6 move container to workspace number 6
    $mod+Shift+7 move container to workspace number 7
    $mod+Shift+8 move container to workspace number 8
    $mod+Shift+9 move container to workspace number 9
    
    # Splits
    $mod+h splith
    $mod+v splitv

    # Something?
    #$mod+Shift+s layout stacking
    #$mod+Shift+w layout tabbed
    $mod+Shift+e layout toggle split

    $mod+Shift+f fullscreen

    $mod+Shift+space floating toggle
    $mod+Alt+space focus mode_toggle

    $mod+a focus parent

    $mod+Shift+minus move scratchpad
    $mod+minus scratchpad show
    
    $mod+Alt+r mode "resize"
    
    # Audio and brightness control
    --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
    --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    --locked XF86MonBrightnessUp exec brightnessctl set 5%+

}
mode "resize" {
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Escape mode "default"
}

bar {
	swaybar_command waybar
	position top
	hidden_state hide
	mode hide
	modifier $mod+Alt
}

include /etc/sway/config.d/*
